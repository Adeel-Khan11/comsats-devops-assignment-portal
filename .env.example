# Local Flask application
SECRET_KEY=replace-with-a-random-secret
DATABASE_PATH=instance/submissions.sqlite3

# Local report receiver
REPORT_RECEIVER_TOKEN=replace-with-a-long-random-token
REPORT_FILE=testreport.json
RECEIVER_HOST=0.0.0.0
RECEIVER_PORT=5001

# Optional SMTP email settings (use CI repository secrets in GitHub Actions)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=sender@example.com
MAIL_TO=recipient@example.com
MAIL_USE_SSL=false
